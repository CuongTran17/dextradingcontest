# MySQL
MYSQL_URL=mysql+mysqlconnector://root:YOUR_PASSWORD@localhost/crypto_dex
MYSQL_ASYNC_URL=mysql+aiomysql://root:YOUR_PASSWORD@localhost/crypto_dex
DB_MIGRATIONS_ENABLED=true

# Crypto market warehouse
CRYPTO_DUCKDB_PATH=lake/warehouse/crypto_market.duckdb
CRYPTO_REPAIR_ON_STARTUP=false
CRYPTO_REALTIME_ON_STARTUP=false
CRYPTO_REPAIR_LOOKBACK_DAYS=365
CRYPTO_REPAIR_INTERVAL_SECONDS=300
CRYPTO_PENDING_ORDER_RECONCILE_ON_STARTUP=false
CRYPTO_ORDER_RECONCILE_INTERVAL_SECONDS=30

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_before_running
JWT_EXPIRE_HOURS=24

# Application URLs
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:8000

# Solana devnet/testnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CONTEST_PROGRAM_ID=9r5T4DCQoY4sAtJm9uH2j7KVahMhyH1qKbd32EsGdaNx
SOLANA_FAUCET_PRIVATE_KEY=
SOLANA_FAUCET_AMOUNT_LAMPORTS=10000000
SOLANA_FAUCET_COOLDOWN_HOURS=24

# Pinata IPFS
